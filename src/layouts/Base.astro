---
const { title = 'L2 KR · Русские переводы', description = 'Редакторский архив переводов обновлений Lineage 2' } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
---
<!doctype html>
<html lang="ru" data-theme="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <title>{title}</title>
    <link rel="alternate" type="application/rss+xml" title="L2 KR RSS" href={base + 'rss.xml'} />
    <link rel="icon" href={base + 'favicon.ico'} sizes="any" />
    <link rel="icon" type="image/png" sizes="48x48" href={base + 'favicon-48x48.png'} />
    <link rel="icon" type="image/png" sizes="32x32" href={base + 'favicon-32x32.png'} />
    <link rel="icon" type="image/png" sizes="16x16" href={base + 'favicon-16x16.png'} />
    <link rel="apple-touch-icon" sizes="180x180" href={base + 'apple-touch-icon.png'} />
    <link rel="manifest" href={base + 'site.webmanifest'} />
    <meta name="theme-color" content="#171a1e" />
    <script is:inline>
      try {
        const saved = localStorage.getItem('l2kr-theme');
        document.documentElement.dataset.theme = saved === 'light' ? 'light' : 'dark';
      } catch (_) { document.documentElement.dataset.theme = 'dark'; }
    </script>
    <style is:global>
:root{--paper:#f3efe6;--ink:#25231f;--muted:#68645e;--wine:#722e38;--dark:#25272b;--line:#d9d1c4;font-family:Georgia,"Times New Roman",serif;color:var(--ink);background:var(--paper);font-size:17px;line-height:1.55}
*{box-sizing:border-box}body{margin:0}a{color:inherit;text-underline-offset:4px}button{font:inherit}a:focus-visible,button:focus-visible,input:focus-visible{outline:3px solid var(--wine);outline-offset:4px}p{margin:0 0 1.1em}h1,h2,h3{line-height:1.12;font-weight:500;letter-spacing:-.035em}img{max-width:100%;height:auto}
.site-header{background:var(--paper)}.site-header-inner{max-width:1340px;margin:auto;padding:22px 40px;display:flex;align-items:center;justify-content:space-between;gap:24px}.brand{display:flex;align-items:center;gap:12px;text-decoration:none;font-family:Georgia,serif;font-weight:700;font-size:1.5rem;letter-spacing:-.06em}.brand img{width:44px;height:44px;border-radius:50%}.brand small{font-size:.65rem;letter-spacing:.01em;font-weight:400;color:var(--wine)}.site-nav{display:flex;align-items:center;gap:28px;font-family:Arial,sans-serif;font-size:.84rem}.site-nav a{text-decoration:none}.site-nav a:hover{color:var(--wine)}
.archive-hero{background:var(--dark);color:#f8f3e9;min-height:540px;overflow:hidden}.hero-inner{max-width:1340px;margin:auto;padding:72px 40px 64px;display:grid;grid-template-columns:1.2fr .8fr;align-items:center;gap:30px}.hero-copy{position:relative;z-index:1}.hero-copy h1{font-size:clamp(3.4rem,6.7vw,7.3rem);line-height:.98;max-width:790px;margin:0 0 30px}.hero-copy p{font-size:clamp(1.1rem,1.6vw,1.35rem);color:#d8d1c6;max-width:510px}.hero-action{display:inline-block;background:#e7d7b8;color:#2c2825;padding:15px 25px;margin-top:14px;text-decoration:none;font-family:Arial,sans-serif;font-size:.9rem;font-weight:700}.hero-action:hover{background:#fff}.hero-art{display:flex;align-items:center;justify-content:center}.hero-portrait{width:min(100%,425px);aspect-ratio:1;overflow:hidden;border-radius:50%;background:#25272b}.hero-art img{display:block;width:100%;height:100%;object-fit:cover;transform:scale(1.28);transform-origin:50% 50%}.hero-stat{font-family:Arial,sans-serif;color:#d3b5a2;font-size:.83rem;margin-top:26px}
.archive-shell{max-width:1340px;margin:auto;padding:80px 40px 125px}.archive-heading{display:flex;justify-content:space-between;align-items:end;gap:25px;margin-bottom:35px}.archive-heading h2{font-size:clamp(2.4rem,4vw,4.6rem);margin:0}.archive-heading p{font-family:Arial,sans-serif;color:var(--muted);max-width:340px;font-size:.88rem;margin:0}
.archive-toolbar{display:flex;align-items:center;justify-content:space-between;gap:24px;flex-wrap:wrap;background:#e7dfd2;padding:18px 22px;margin-bottom:25px}.filter-list{display:flex;gap:4px;flex-wrap:wrap}.filter-button{border:0;background:transparent;padding:11px 17px;cursor:pointer;font-family:Arial,sans-serif;font-size:.82rem;color:#45413d}.filter-button:hover,.filter-button[aria-pressed=true]{background:var(--wine);color:#fff}.archive-search{background:#fff;border:0;padding:12px 15px;font-family:Arial,sans-serif;font-size:.86rem;min-width:230px;max-width:100%}
.patch-preview{display:grid;grid-template-columns:165px 1fr;gap:40px;padding:34px 0 40px;border-bottom:1px solid var(--line)}.patch-preview[hidden]{display:none}.patch-date{font-family:Arial,sans-serif;font-size:.9rem;color:var(--wine);font-weight:700;margin:0 0 7px}.patch-family{font-family:Arial,sans-serif;color:var(--muted);font-size:.79rem}.patch-preview h3{font-size:clamp(1.55rem,2.5vw,2.55rem);margin:0 0 13px;max-width:820px}.patch-preview h3 a{text-decoration:none}.patch-preview h3 a:hover{color:var(--wine)}.patch-summary{font-family:Arial,sans-serif;color:#58534d;max-width:780px;line-height:1.7;font-size:.93rem}.patch-meta{display:flex;flex-wrap:wrap;gap:7px}.tag{font-family:Arial,sans-serif;font-size:.72rem;background:#e5ded2;color:#5e574e;padding:5px 9px}.patch-open{display:inline-block;margin-top:17px;font-family:Arial,sans-serif;font-size:.82rem;font-weight:700;color:var(--wine);text-decoration:none}.patch-open:hover{text-decoration:underline}
.reading-shell{max-width:1100px;margin:auto;padding:70px 40px 110px}.article-header{max-width:940px;margin:0 auto 65px}.article-header h1{font-size:clamp(2.4rem,5vw,5rem);margin:20px 0}.article-header .summary{font-size:1.25rem;color:#58534d;line-height:1.5}.article-body{max-width:800px;margin:auto;font-size:1.07rem;line-height:1.8}.article-body h2{font-size:2.1rem;margin:2em 0 .6em}.article-body h3{font-size:1.5rem;margin:1.8em 0 .5em}.article-body p{line-height:1.8}.article-body ul,.article-body ol{padding-left:1.4rem}.article-body li{margin:.5em 0}.article-body a{color:var(--wine)}.article-body blockquote{margin:28px 0;padding:12px 25px;background:#e9e1d4}.article-body strong{color:#1b1916}.eyebrow{font-family:Arial,sans-serif;color:var(--wine);font-size:.84rem}.article-header>a{font-family:Arial,sans-serif;color:var(--wine);font-size:.86rem}
table{display:block;overflow-x:auto;max-width:100%;border-collapse:collapse;margin:28px 0;font-family:Arial,sans-serif;font-size:.88rem}th,td{border:1px solid #ccc2b4;padding:10px 13px}th{background:#e7dfd2}
footer{background:var(--dark);color:#f4efe5;padding:60px 40px}.footer-inner{max-width:1260px;margin:auto;display:flex;justify-content:space-between;align-items:end;gap:35px}.footer-inner strong{font-size:clamp(2rem,4vw,4rem);font-weight:400;letter-spacing:-.05em;line-height:1}.footer-inner p{font-family:Arial,sans-serif;color:#c2bcb3;font-size:.8rem;max-width:280px;margin:0}
@media(max-width:800px){.site-header-inner{padding:16px 20px}.hero-inner{grid-template-columns:1fr;padding:60px 22px 55px}.hero-copy h1{font-size:clamp(3.1rem,10vw,5.5rem)}.hero-art{display:none}.archive-shell{padding:55px 22px 85px}.archive-heading{display:block}.archive-heading p{margin-top:15px}.patch-preview{grid-template-columns:1fr;gap:9px}.patch-family{margin:0}.archive-toolbar{padding:15px}.footer-inner{display:block}.footer-inner p{margin-top:22px}.reading-shell{padding:40px 22px 85px}}
@media(max-width:440px){.brand{font-size:1.22rem}.brand img{width:34px;height:34px}.site-nav{gap:12px}.archive-search{width:100%}.filter-button{padding:9px 11px}.hero-copy h1{font-size:3.15rem}}
@media(prefers-reduced-motion:no-preference){.hero-art img{animation:portrait-enter 900ms ease-out both}.hero-copy{animation:copy-enter 650ms ease-out both}.patch-preview{animation:copy-enter 550ms ease-out both}@keyframes portrait-enter{from{opacity:0;transform:translateY(24px)}to{opacity:1;transform:translateY(0)}}@keyframes copy-enter{from{opacity:0;transform:translateY(15px)}to{opacity:1;transform:translateY(0)}}}

/* Theme tokens: dark is the default, light is an explicit choice. */
:root,[data-theme="dark"]{color-scheme:dark;--paper:#171a1e;--ink:#eee8dd;--muted:#b6b0a7;--wine:#e3a28e;--dark:#22252a;--line:#3b3d41;--toolbar:#282b30;--field:#202329;--field-ink:#eee8dd;--field-placeholder:#b6b0a7;--filter-ink:#ddd5ca;--filter-active:#bc705f;--filter-active-ink:#fffaf5;--summary:#c6bfb4;--tag-bg:#2c3035;--tag-ink:#d4cbc0;--quote-bg:#292d32;--table-border:#47494d;--table-head:#2a2e33;--strong:#fff8ed;--hero-bg:#22252a;--hero-ink:#f8f3e9;--footer-bg:#202226;--footer-ink:#f4efe5;--footer-muted:#c2bcb3;--button-bg:#e7d7b8;--button-ink:#2c2825;--button-hover:#fff;--brand-accent:#e3a28e}
[data-theme="light"]{color-scheme:light;--paper:#f3efe6;--ink:#25231f;--muted:#68645e;--wine:#722e38;--dark:#25272b;--line:#d9d1c4;--toolbar:#e7dfd2;--field:#fff;--field-ink:#25231f;--field-placeholder:#68645e;--filter-ink:#45413d;--filter-active:#722e38;--filter-active-ink:#fff;--summary:#58534d;--tag-bg:#e5ded2;--tag-ink:#5e574e;--quote-bg:#e9e1d4;--table-border:#ccc2b4;--table-head:#e7dfd2;--strong:#1b1916;--hero-bg:#25272b;--hero-ink:#f8f3e9;--footer-bg:#25272b;--footer-ink:#f4efe5;--footer-muted:#c2bcb3;--button-bg:#e7d7b8;--button-ink:#2c2825;--button-hover:#fff;--brand-accent:#722e38}
:root{background:var(--paper);color:var(--ink)}
body,.site-header{background:var(--paper);color:var(--ink)}
.brand small{color:var(--brand-accent)}
.site-nav a:hover,.patch-preview h3 a:hover{color:var(--wine)}
.archive-hero{background:var(--hero-bg);color:var(--hero-ink)}
.hero-action{background:var(--button-bg);color:var(--button-ink)}
.hero-action:hover{background:var(--button-hover)}
.archive-toolbar{background:var(--toolbar)}
.filter-button{color:var(--filter-ink)}
.filter-button:hover,.filter-button[aria-pressed=true]{background:var(--filter-active);color:var(--filter-active-ink)}
.archive-search{background:var(--field);color:var(--field-ink);border:1px solid var(--line)}
.archive-search::placeholder{color:var(--field-placeholder)}
.patch-summary,.article-header .summary{color:var(--summary)}
.tag{background:var(--tag-bg);color:var(--tag-ink)}
.article-body strong{color:var(--strong)}
.article-body blockquote{background:var(--quote-bg)}
th,td{border-color:var(--table-border)}th{background:var(--table-head)}
footer{background:var(--footer-bg);color:var(--footer-ink)}
.footer-inner p{color:var(--footer-muted)}
.theme-toggle{display:inline-flex;align-items:center;justify-content:center;width:40px;height:40px;flex-shrink:0;border:0;border-radius:50%;background:transparent;color:var(--ink);padding:0;cursor:pointer;line-height:1}
.theme-toggle:hover{background:var(--toolbar)}
.theme-toggle svg{width:21px;height:21px;flex-shrink:0;stroke-linecap:round;stroke-linejoin:round}
.theme-toggle .icon-sun{display:none}
[data-theme="dark"] .theme-toggle .icon-sun{display:block}
[data-theme="dark"] .theme-toggle .icon-moon{display:none}
::selection{background:var(--filter-active);color:var(--filter-active-ink)}
@media(prefers-reduced-motion:no-preference){html.theme-transition,html.theme-transition body,html.theme-transition .site-header,html.theme-transition .archive-toolbar,html.theme-transition .archive-search,html.theme-transition .filter-button,html.theme-transition .patch-preview,html.theme-transition .tag,html.theme-transition .article-body blockquote,html.theme-transition footer,html.theme-transition .theme-toggle{transition:background-color .3s ease,color .3s ease,border-color .3s ease}}
@media(max-width:440px){.theme-toggle{width:40px;height:40px}.site-nav{gap:10px}}
    </style>
  </head>
  <body>
    <header class="site-header"><div class="site-header-inner"><a class="brand" href={base}><span>LINEAGE <small>II</small> / KR</span></a><nav class="site-nav" aria-label="Навигация"><a href={base + '#archive'}>Архив</a><a href={base + 'rss.xml'}>RSS ↗</a><button class="theme-toggle" type="button" aria-label="Переключить цветовую тему" aria-pressed="true" title="Сменить тему"><svg class="icon-sun" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><circle cx="12" cy="12" r="4"/><path d="M12 2v2m0 16v2M4.93 4.93l1.42 1.42m11.3 11.3 1.42 1.42M2 12h2m16 0h2M4.93 19.07l1.42-1.42m11.3-11.3 1.42-1.42"/></svg><svg class="icon-moon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M20.5 14.4A8.7 8.7 0 0 1 9.6 3.5 8.7 8.7 0 1 0 20.5 14.4Z"/></svg></button></nav></div></header>
    <main><slot /></main>
    <footer><div class="footer-inner"><strong>История изменений.<br />На твоём языке.</strong><p>Неофициальные русские переводы корейских обновлений Lineage 2. Оригиналы — NC Korea.</p></div></footer>
    <script is:inline>
      (() => {
        const toggle = document.querySelector('.theme-toggle');
        if (!toggle) return;
        const sync = () => {
          const dark = document.documentElement.dataset.theme !== 'light';
          toggle.setAttribute('aria-pressed', String(dark));
          toggle.setAttribute('aria-label', dark ? 'Включить светлую тему' : 'Включить тёмную тему');
          toggle.setAttribute('title', dark ? 'Включить светлую тему' : 'Включить тёмную тему');
          const meta = document.querySelector('meta[name="theme-color"]');
          if (meta) meta.setAttribute('content', dark ? '#171a1e' : '#f3efe6');
        };
        toggle.addEventListener('click', () => {
          const next = document.documentElement.dataset.theme === 'dark' ? 'light' : 'dark';
          if (!window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
            document.documentElement.classList.add('theme-transition');
            window.setTimeout(() => document.documentElement.classList.remove('theme-transition'), 350);
          }
          document.documentElement.dataset.theme = next;
          try { localStorage.setItem('l2kr-theme', next); } catch (_) {}
          sync();
        });
        sync();
      })();
    </script>
  </body>
</html>
