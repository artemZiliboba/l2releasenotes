---
import Base from '../layouts/Base.astro';
import { getCollection } from 'astro:content';
const patches = (await getCollection('patches')).sort((a,b) => b.data.date.getTime() - a.data.date.getTime());
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
const formatTitle = (title: string, date: Date) => {
  const stamp = date.toLocaleDateString('ru-RU');
  let label = title.replace(/[—–]/g, '-').trim();
  label = label.replace(/^\d{1,2}\.\d{1,2}\.\d{4}\s*-\s*/, '');
  label = label.replace(/\s*-\s*обновление\s+\d{1,2}\s+[а-яё]+\s+\d{4}\s+года?$/i, ': обновление');
  label = label.replace(/^Обновление\s+\d{1,2}\s+[а-яё]+(?:\s+\d{4})?:\s*/i, 'Обновление: ');
  return stamp + ' - ' + label;
};
---
<Base title="Lineage 2 KR — патчноуты на русском" description="Полные переводы обновлений Lineage 2 с корейских серверов NCSoft.">
  <section class="archive-hero">
    <div class="hero-inner">
      <div class="hero-copy">
        <h1>Мир меняется.<br />Будь в курсе.</h1>
        <p>Полные переводы корейских обновлений Lineage 2. От осад и баланса классов до предметов и исправлений.</p>
        <a class="hero-action" href="#archive">Смотреть обновления ↓</a>
        <div class="hero-stat">{patches.length} переводов в архиве · Оригиналы NCSoft</div>
      </div>
      <div class="hero-art"><img src={base + 'android-chrome-512x512.png'} alt="Эльфийка — символ архива Lineage 2 KR" width="425" height="425" /></div>
    </div>
  </section>
  <div class="archive-shell" id="archive">
    <div class="archive-heading">
      <h2>Хроника обновлений</h2>
      <p>Выбирай сервер или ищи по названию и описанию. Каждый материал ведёт к полному переводу.</p>
    </div>
    <div class="archive-toolbar">
      <div class="filter-list" role="group" aria-label="Сервер">
        <button class="filter-button" type="button" data-filter="all" aria-pressed="true">Все</button>
        <button class="filter-button" type="button" data-filter="main" aria-pressed="false">Main</button>
        <button class="filter-button" type="button" data-filter="basic" aria-pressed="false">BASIC</button>
        <button class="filter-button" type="button" data-filter="talking" aria-pressed="false">Talking Island</button>
      </div>
      <input class="archive-search" type="search" aria-label="Поиск по обновлениям" placeholder="Найти обновление…" />
    </div>
    <div class="patch-list">
      {patches.length === 0 ? <p>Пока нет переводов.</p> : patches.map(p => {
        const title = formatTitle(p.data.title, p.data.date).replace(/^\d{1,2}\.\d{1,2}\.\d{4}\s*-\s*/, '');
        const source = (p.data.title + ' ' + p.data.version).toLowerCase();
        const family = /talking island/i.test(source) ? 'talking' : /basic/i.test(source) ? 'basic' : /main/i.test(source) ? 'main' : 'other';
        const familyName = family === 'talking' ? 'Talking Island' : family === 'basic' ? 'BASIC' : family === 'main' ? 'Main' : p.data.version;
        const url = base + 'patches/' + p.id + '/';
        return <article class="patch-preview" data-family={family} data-search={(title + ' ' + p.data.summary + ' ' + p.data.categories.join(' ')).toLowerCase()}>
          <div><p class="patch-date"><time datetime={p.data.date.toISOString()}>{p.data.date.toLocaleDateString('ru-RU')}</time></p><p class="patch-family">{familyName}</p></div>
          <div><h3><a href={url}>{title}</a></h3><p class="patch-summary">{p.data.summary}</p><div class="patch-meta">{p.data.categories.map(c => <span class="tag">{c}</span>)}</div><a class="patch-open" href={url}>Читать полный перевод ↗</a></div>
        </article>;
      })}
      <p id="filter-empty" hidden>По этому запросу обновлений не найдено.</p>
    </div>
  </div>
  <script>
    const buttons = document.querySelectorAll<HTMLButtonElement>('[data-filter]');
    const articles = document.querySelectorAll<HTMLElement>('.patch-preview[data-family]');
    const search = document.querySelector<HTMLInputElement>('.archive-search');
    const empty = document.getElementById('filter-empty');
    let currentFilter = 'all';
    const applyFilters = () => {
      const query = (search?.value || '').trim().toLocaleLowerCase('ru');
      let visible = 0;
      articles.forEach(article => {
        const matchesServer = currentFilter === 'all' || article.dataset.family === currentFilter;
        const matchesText = !query || (article.dataset.search || '').includes(query);
        article.hidden = !(matchesServer && matchesText);
        if (!article.hidden) visible++;
      });
      if (empty) empty.hidden = visible !== 0;
    };
    buttons.forEach(button => button.addEventListener('click', () => {
      currentFilter = button.dataset.filter || 'all';
      buttons.forEach(b => b.setAttribute('aria-pressed', String(b === button)));
      applyFilters();
    }));
    search?.addEventListener('input', applyFilters);
  </script>
</Base>
