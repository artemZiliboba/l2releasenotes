---
import Base from '../layouts/Base.astro';
import { getCollection } from 'astro:content';
const patches = (await getCollection('patches')).sort((a,b) => b.data.date.getTime() - a.data.date.getTime());
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
const formatTitle = (title: string, date: Date) => {
  const stamp = date.toLocaleDateString('ru-RU');
  let label = title.replace(/[—–]/g, '-').trim();
  label = label.replace(/^\d{1,2}\.\d{1,2}\.\d{4}\s*-\s*/, '');
  label = label.replace(/\s*-\s*обновление\s+\d{1,2}\s+[а-яё]+\s+\d{4}\s+года?$/i, ': обновление');
  label = label.replace(/^Обновление\s+\d{1,2}\s+[а-яё]+(?:\s+\d{4})?:\s*/i, 'Обновление: ');
  return stamp + ' - ' + label;
};
---
<Base>
  <h1>Корейские обновления Lineage 2</h1>
  <p class="summary">Русские переводы для редакторской работы. Полные тексты, оригинальные источники и краткое описание изменений.</p>
  {patches.length === 0
    ? <p>Пока нет переводов.</p>
    : patches.map(p => <article class="patch-preview">
        <p class="eyebrow"><time datetime={p.data.date.toISOString()}>{p.data.date.toLocaleDateString('ru-RU')}</time> · {p.data.version}</p>
        <h2><a href={base + 'patches/' + p.id + '/'}>{formatTitle(p.data.title, p.data.date)}</a></h2>
        <p>{p.data.summary}</p>
        <div>{p.data.categories.map(c => <span class="tag">{c}</span>)}</div>
      </article>)
  }
</Base>
