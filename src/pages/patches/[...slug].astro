---
import Base from '../../layouts/Base.astro';
import { getCollection, render } from 'astro:content';
export async function getStaticPaths() {
  const patches = await getCollection('patches');
  return patches.map(p => ({ params: { slug: p.id }, props: { patch: p } }));
}
const { patch } = Astro.props;
const { Content } = await render(patch);
---
<Base title={patch.data.title} description={patch.data.summary}>
  <div class="article-header">
    <p class="eyebrow"><time datetime={patch.data.date.toISOString()}>{patch.data.date.toLocaleDateString('ru-RU')}</time> · {patch.data.version}</p>
    <h1>{patch.data.title}</h1>
    <p class="summary">{patch.data.summary}</p>
    <a href={patch.data.source_url} rel="noopener noreferrer" target="_blank">Оригинал NC Korea ↗</a>
  </div>
  <div class="article-body"><Content /></div>
</Base>
